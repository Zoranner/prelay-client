{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prelay",
  "version": "0.1.7",
  "identifier": "ink.zoran.prelay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:18081",
    "beforeBuildCommand": "bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prelay",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Zoranner",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
